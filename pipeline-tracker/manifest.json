{
  "manifest_version": 3,
  "name": "Loop Back",
  "version": "1.0.0",
  "description": "Gmail thread-state tracker for sales pipelines",
  "permissions": [
    "identity",
    "alarms",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://www.googleapis.com/*",
    "https://api.groq.com/*",
    "https://*.supabase.co/*"
  ],
  "oauth2": {
    "client_id": "951781401687-69qut848abp83q1402fiva3asurtjiim.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/loop-back-chrome.js", "content/inject-sidebar.js", "content/sidebar/sidebar.js"],
      "css": ["content/sidebar/sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
